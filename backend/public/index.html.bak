    <!-- Three.js 3D Background -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // Fondo 3D Constelación
        (function init3D() {
            const canvas = document.getElementById('canvas3d');
            if (!canvas || !window.THREE) return;

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 1, 1000);
            camera.position.z = 400;

            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const particleCount = 75;
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(particleCount * 3);
            const velocities = [];

            for (let i = 0; i < particleCount; i++) {
                positions[i * 3] = (Math.random() - 0.5) * 800;
                positions[i * 3 + 1] = (Math.random() - 0.5) * 600;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 400;

                velocities.push({
                    x: (Math.random() - 0.5) * 0.45,
                    y: (Math.random() - 0.5) * 0.45,
                    z: (Math.random() - 0.5) * 0.25
                });
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

            const material = new THREE.PointsMaterial({
                color: 0x8b5cf6,
                size: 3.5,
                transparent: true,
                opacity: 0.7
            });

            const points = new THREE.Points(geometry, material);
            scene.add(points);

            function animate() {
                requestAnimationFrame(animate);
                const pos = geometry.attributes.position.array;
                for (let i = 0; i < particleCount; i++) {
                    pos[i * 3] += velocities[i].x;
                    pos[i * 3 + 1] += velocities[i].y;
                    pos[i * 3 + 2] += velocities[i].z;

                    if (pos[i * 3] > 400 || pos[i * 3] < -400) velocities[i].x *= -1;
                    if (pos[i * 3 + 1] > 300 || pos[i * 3 + 1] < -300) velocities[i].y *= -1;
                    if (pos[i * 3 + 2] > 200 || pos[i * 3 + 2] < -200) velocities[i].z *= -1;
                }
                geometry.attributes.position.needsUpdate = true;
                points.rotation.y += 0.0006;
                renderer.render(scene, camera);
            }
            animate();

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        })();

        // ==========================================
        // ESTADO GLOBAL DE LA APLICACIÓN
        // ==========================================
        let currentUser = null;
        let currentView = 'inicio';
        let currentTool = localStorage.getItem('tj_active_tool') || 'adaptar';
        let selectedStyleFormat = 'ats';

        // Verificación de sesión al recargar página
        async function checkSession() {
            const token = localStorage.getItem('tj_token');
            if (!token) {
                renderUnauth();
                return;
            }
            try {
                const res = await fetch('/api/auth/me', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok && data.user) {
                    currentUser = data.user;
                    renderAuthUser(currentUser);
                    
                    // Al recargar estando logeado: entrar directo a la herramienta
                    const savedView = sessionStorage.getItem('tj_preferred_view');
                    if (savedView && ['acerca', 'faq', 'contacto'].includes(savedView)) {
                        mostrarVista(savedView);
                    } else {
                        mostrarVista('app');
                    }
                } else {
                    renderUnauth();
                }
            } catch (err) {
                renderUnauth();
            }
        }

        function renderUnauth() {
            currentUser = null;
            document.getElementById('unauthNav').style.display = 'flex';
            document.getElementById('authNav').style.display = 'none';
            document.getElementById('btnToggleVistaLeft').style.display = 'none';
            document.getElementById('publicNavMenu').style.display = 'flex';
            document.getElementById('appToolSelector').style.display = 'none';
            document.getElementById('supportWidgetWrapper').style.display = 'none';
            mostrarVista('inicio');
        }

        function renderAuthUser(user) {
            document.getElementById('unauthNav').style.display = 'none';
            document.getElementById('authNav').style.display = 'flex';
            document.getElementById('btnToggleVistaLeft').style.display = 'block';
            document.getElementById('supportWidgetWrapper').style.display = (currentView === 'app') ? 'block' : 'none';

            document.getElementById('userNameHeader').innerText = user.nombre.split(' ')[0];
            document.getElementById('userInitial').innerText = user.nombre.charAt(0).toUpperCase();
            
            const ddName = document.getElementById('ddUserName');
            if (ddName) ddName.innerText = user.nombre;
            const ddEmail = document.getElementById('ddUserEmail');
            if (ddEmail) ddEmail.innerText = user.email;

            const flyoutName = document.getElementById('flyoutUserName');
            if (flyoutName) flyoutName.innerText = user.nombre.split(' ')[0];

            // Badges
            const coinBadge = document.getElementById('coinBadge');
            const dashCoins = document.getElementById('dashCoinsDisplay');
            const appAdBanner = document.getElementById('appAdBanner');
            const fabBtn = document.getElementById('supportFabBtn');
            const flyoutProSection = document.getElementById('flyoutProSection');
            const flyoutFreeGate = document.getElementById('flyoutFreeGate');
            const ddPlan = document.getElementById('ddUserPlan');

            if (user.rol === 'reclutador') {
                if (coinBadge) coinBadge.style.display = 'none';
                if (dashCoins) dashCoins.innerText = '∞';
                if (appAdBanner) appAdBanner.style.display = 'none';
                if (fabBtn) fabBtn.classList.remove('pro-glow');
                if (flyoutProSection) flyoutProSection.style.display = 'none';
                if (flyoutFreeGate) flyoutFreeGate.style.display = 'none';
                if (ddPlan) ddPlan.innerText = '🏢 Cuenta Reclutador';
            } else if (user.plan === 'pro_unlimited') {
                if (coinBadge) coinBadge.style.display = 'flex';
                coinBadge.className = 'pro-badge';
                coinBadge.innerText = '👑 Plan PRO';
                if (dashCoins) dashCoins.innerText = '∞';
                if (appAdBanner) appAdBanner.style.display = 'none';
                if (fabBtn) fabBtn.classList.add('pro-glow');
                if (flyoutProSection) flyoutProSection.style.display = 'block';
                if (flyoutFreeGate) flyoutFreeGate.style.display = 'none';
                if (ddPlan) ddPlan.innerText = '👑 Plan PRO Ilimitado';
            } else {
                if (coinBadge) coinBadge.style.display = 'flex';
                coinBadge.className = 'coin-badge';
                coinBadge.innerText = '⚡ ' + user.trabajacoins_saldo + ' TC';
                if (dashCoins) dashCoins.innerText = user.trabajacoins_saldo;
                if (appAdBanner) appAdBanner.style.display = 'flex';
                if (fabBtn) fabBtn.classList.remove('pro-glow');
                if (flyoutProSection) flyoutProSection.style.display = 'none';
                if (flyoutFreeGate) flyoutFreeGate.style.display = 'block';
                if (ddPlan) ddPlan.innerText = '⚡ ' + user.trabajacoins_saldo + ' TrabajaCoins';
            }

            // Adaptar navegación según ROL (Candidato vs Reclutador)
            const esReclutador = user.rol === 'reclutador';
            const navCand = document.getElementById('navGroupCandidato');
            const navRec = document.getElementById('navGroupReclutador');
            if (navCand) navCand.style.display = esReclutador ? 'none' : 'flex';
            if (navRec) navRec.style.display = esReclutador ? 'flex' : 'none';

            actualizarVistaExpediente();
        }

        // ==========================================
        // VISTAS PRINCIPALES (SPA)
        // ==========================================
        function mostrarVista(vistaId) {
            if (vistaId === 'app' && !currentUser) {
                abrirModal('login');
                return;
            }

            document.querySelectorAll('.view-pane').forEach(el => el.classList.remove('active-pane'));
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

            const targetPane = document.getElementById('vista-' + vistaId);
            const targetNav = document.getElementById('nav-' + vistaId);

            if (targetPane) targetPane.classList.add('active-pane');
            if (targetNav) targetNav.classList.add('active');

            currentView = vistaId;
            sessionStorage.setItem('tj_preferred_view', vistaId);

            const publicNav = document.getElementById('publicNavMenu');
            const toolSelector = document.getElementById('appToolSelector');
            const btnToggleLeft = document.getElementById('txtBtnToggleVista');

            if (vistaId === 'app') {
                publicNav.style.display = 'none';
                toolSelector.style.display = 'flex';
                if (btnToggleLeft) btnToggleLeft.innerText = '🌐 Ver Sitio';
                const defaultTool = (currentUser && currentUser.rol === 'reclutador') ? 'reclutador-vacantes' : 'muro';
                seleccionarHerramienta(currentTool || defaultTool);
            } else {
                publicNav.style.display = 'flex';
                toolSelector.style.display = 'none';
                if (btnToggleLeft) btnToggleLeft.innerText = '🚀 Herramienta';
            }

            // Botón flotante Soporte VIP
            const supportWidget = document.getElementById('supportWidgetWrapper');
            if (supportWidget) {
                if (currentUser && vistaId === 'app') {
                    supportWidget.style.display = 'block';
                } else {
                    supportWidget.style.display = 'none';
                    const flyout = document.getElementById('supportFlyout');
                    if (flyout) flyout.style.display = 'none';
                }
            }
        }

        function toggleVistaLandingApp() {
            if (currentView === 'app') {
                mostrarVista('inicio');
            } else {
                mostrarVista('app');
            }
        }

        function clickLogoBrand() {
            if (currentUser) {
                mostrarVista('app');
            } else {
                mostrarVista('inicio');
            }
        }

        function irALaHerramienta() {
            if (!currentUser) {
                abrirModal('login');
            } else {
                mostrarVista('app');
            }
        }

        // ==========================================
        // SELECCIÓN DE HERRAMIENTAS
        // ==========================================
        function seleccionarHerramienta(toolId) {
            // Validar que el usuario no acceda a módulos fuera de su rol
            if (currentUser && currentUser.rol === 'candidato' && toolId.startsWith('reclutador')) {
                toolId = 'muro';
            } else if (currentUser && currentUser.rol === 'reclutador' && ['muro', 'expediente', 'adaptar', 'mis-postulaciones'].includes(toolId)) {
                toolId = 'reclutador-vacantes';
            }

            currentTool = toolId;
            localStorage.setItem('tj_active_tool', toolId);

            document.querySelectorAll('.tool-tab-btn').forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.getElementById('btnTool-' + toolId);
            if (activeBtn) activeBtn.classList.add('active');

            document.querySelectorAll('.module-pane').forEach(m => m.classList.remove('active-module'));
            const targetMod = document.getElementById('mod-' + toolId);
            if (targetMod) targetMod.classList.add('active-module');

            if (toolId === 'muro') cargarMuroVacantes();
            if (toolId === 'mis-postulaciones') cargarMisPostulaciones();
            if (toolId === 'expediente') actualizarVistaExpediente();
            if (toolId === 'reclutador-vacantes') cargarVacantesUI();
            if (toolId === 'reclutador-metricas') cargarMetricasReclutador();
            if (toolId === 'reclutador-candidatos-tab') poblarSelectVacantesCandidatos();
        }

        // ==========================================
        // MENÚ DROPDOWN DE USUARIO
        // ==========================================
        function toggleUserDropdown(e) {
            if (e) e.stopPropagation();
            const dd = document.getElementById('userDropdownMenu');
            if (!dd) return;
            if (dd.style.display === 'block') {
                dd.style.display = 'none';
            } else {
                if (currentUser) {
                    document.getElementById('ddUserName').innerText = currentUser.nombre;
                    document.getElementById('ddUserEmail').innerText = currentUser.email;
                    const ddPlanText = (currentUser.rol === 'reclutador')
                        ? '🏢 Cuenta Reclutador (Gratis)'
                        : (currentUser.plan === 'pro_unlimited' ? '👑 Plan PRO Ilimitado' : '⚡ ' + currentUser.trabajacoins_saldo + ' TC');
                    document.getElementById('ddUserPlan').innerText = ddPlanText;
                    const expSec = document.getElementById('userDdExpedienteSection');
                    if (expSec) {
                        expSec.style.display = (currentUser.rol === 'reclutador') ? 'none' : 'block';
                    }
                    const badge = document.getElementById('ddExpedienteBadge');
                    if (badge) {
                        badge.innerText = currentUser.perfil_maestro ? 'Sincronizado' : 'No cargado';
                        badge.style.color = currentUser.perfil_maestro ? '#10b981' : '#f87171';
                    }
                }
                dd.style.display = 'block';
            }
        }

        // ==========================================
        // MÓDULO 1: EXPEDIENTE MAESTRO PERMANENTE
        // ==========================================
        function mostrarNombreMaster(input) {
            const label = document.getElementById('masterFileName');
            if (input.files && input.files[0]) {
                label.innerText = '✓ ' + input.files[0].name + ' (' + Math.round(input.files[0].size / 1024) + ' KB)';
            }
        }

        function actualizarVistaExpediente() {
            const hasMaster = !!(currentUser && currentUser.perfil_maestro);
            const viewLoaded = document.getElementById('masterLoadedCard');
            const viewEmpty = document.getElementById('masterEmptyCard');
            const warningAdaptar = document.getElementById('adaptarNoMasterWarning');
            const gridAdaptar = document.getElementById('adaptarMainGrid');
            const pillAdaptar = document.getElementById('adaptarActiveMasterPill');

            if (hasMaster) {
                if (viewLoaded) viewLoaded.style.display = 'block';
                if (viewEmpty) viewEmpty.style.display = 'none';
                if (warningAdaptar) warningAdaptar.style.display = 'none';
                if (gridAdaptar) gridAdaptar.style.display = 'grid';
                if (pillAdaptar) pillAdaptar.style.display = 'flex';

                const master = currentUser.perfil_maestro;
                const docName = master.nombreArchivo || 'Expediente_Maestro.pdf';
                const fecha = new Date(master.actualizadoEn || Date.now()).toLocaleDateString('es-GT', { year: 'numeric', month: 'short', day: 'numeric' });
                
                const titleEl = document.getElementById('masterDocTitle');
                if (titleEl) titleEl.innerText = docName;
                const metaEl = document.getElementById('masterDocMeta');
                if (metaEl) metaEl.innerText = 'Sincronizado: ' + fecha + ' • Tamaño: ' + Math.round((master.tamano || 0) / 1024) + ' KB';

                const candName = master.datos?.nombre || currentUser.nombre;
                const candRole = master.datos?.profesion || 'Profesional';
                const infoEl = document.getElementById('masterCandidateInfo');
                if (infoEl) infoEl.innerText = candName + ' — ' + candRole;

                const sumEl = document.getElementById('masterSummaryPreview');
                if (sumEl) sumEl.innerText = master.resumenEjecutivo || master.datos?.resumen || 'Perfil maestro consolidado en base de datos PostgreSQL.';

                const skillsWrap = document.getElementById('masterSkillsCloud');
                if (skillsWrap) {
                    skillsWrap.innerHTML = '';
                    const skills = master.datos?.habilidades || ['Ingeniería de Sistemas', 'Desarrollo de Software', 'PostgreSQL', 'Linux'];
                    skills.slice(0, 15).forEach(sk => {
                        const sp = document.createElement('span');
                        sp.className = 'tag-pill-ok';
                        sp.innerText = sk;
                        skillsWrap.appendChild(sp);
                    });
                }

                const namePill = document.getElementById('adaptarMasterNameDisplay');
                if (namePill) namePill.innerText = candName + ' (' + candRole + ')';

                const ddBadge = document.getElementById('ddExpedienteBadge');
                if (ddBadge) {
                    ddBadge.innerText = 'Sincronizado';
                    ddBadge.style.color = '#10b981';
                }
            } else {
                if (viewLoaded) viewLoaded.style.display = 'none';
                if (viewEmpty) viewEmpty.style.display = 'block';
                if (warningAdaptar) warningAdaptar.style.display = 'block';
                if (gridAdaptar) gridAdaptar.style.display = 'none';
                if (pillAdaptar) pillAdaptar.style.display = 'none';

                const ddBadge = document.getElementById('ddExpedienteBadge');
                if (ddBadge) {
                    ddBadge.innerText = 'No cargado';
                    ddBadge.style.color = '#f87171';
                }
            }
        }

        async function guardarPerfilMaestro(e) {
            e.preventDefault();
            const input = document.getElementById('masterFileInput');
            if (!input.files || !input.files[0]) {
                alert('Selecciona un archivo PDF para consolidar tu Expediente Maestro.');
                return;
            }

            const token = localStorage.getItem('tj_token');
            const formData = new FormData();
            formData.append('resume', input.files[0]);

            const btn = document.getElementById('btnMasterSave');
            const txt = document.getElementById('txtBtnSaveMaster');
            const loader = document.getElementById('txtLoaderSaveMaster');

            btn.disabled = true;
            txt.style.display = 'none';
            loader.style.display = 'inline';

            try {
                const res = await fetch('/api/cv/master', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token },
                    body: formData
                });
                const data = await res.json();
                if (res.ok) {
                    alert('✓ ' + data.message);
                    currentUser.perfil_maestro = data.perfilMaestro;
                    actualizarVistaExpediente();
                } else {
                    alert('Error: ' + (data.error || 'No se pudo sincronizar el expediente'));
                }
            } catch (err) {
                alert('Error al comunicar con el servidor.');
            } finally {
                btn.disabled = false;
                txt.style.display = 'inline';
                loader.style.display = 'none';
            }
        }

        async function toggleVisorPdfMaster() {
            const container = document.getElementById('visorPdfMasterContainer');
            const icon = document.getElementById('btnTogglePdfIcon');
            const iframe = document.getElementById('iframePdfMaster');
            const downloadLink = document.getElementById('linkDescargarPdfMaster');
            const token = localStorage.getItem('tj_token');

            if (!container) return;

            if (container.style.display === 'none' || container.style.display === '') {
                container.style.display = 'block';
                icon.innerText = '[- Ocultar]';

                // Si aún no se ha cargado el PDF en el iframe, solicitarlo con auth
                if (iframe.src === 'about:blank' || !iframe.src) {
                    try {
                        const res = await fetch('/api/cv/master/pdf', {
                            headers: { 'Authorization': 'Bearer ' + token }
                        });
                        if (res.ok) {
                            const blob = await res.blob();
                            const blobUrl = URL.createObjectURL(blob);
                            iframe.src = blobUrl;
                            downloadLink.href = blobUrl;
                        } else {
                            iframe.srcdoc = '<div style="color: #94a3b8; font-family: sans-serif; text-align: center; padding: 2rem;">No hay un PDF almacenado en disco para este expediente. Vuelve a subir tu PDF en Expediente para habilitar la vista previa visual.</div>';
                        }
                    } catch (e) {
                        iframe.srcdoc = '<div style="color: #ef4444; font-family: sans-serif; text-align: center; padding: 2rem;">Error al cargar vista previa del PDF.</div>';
                    }
                }
            } else {
                container.style.display = 'none';
                icon.innerText = '[+ Expandir]';
            }
        }

        async function confirmarBorrarExpediente() {
            if (!currentUser || !currentUser.perfil_maestro) {
                alert('No tienes ningún Expediente Maestro activo.');
                return;
            }
            if (confirm('¿Estás seguro de que deseas eliminar tu Expediente Maestro? Deberás subir uno nuevo para poder adaptar tu currículum.')) {
                const token = localStorage.getItem('tj_token');
                try {
                    const res = await fetch('/api/cv/master', {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                    const data = await res.json();
                    if (data.success) {
                        currentUser.perfil_maestro = null;
                        actualizarVistaExpediente();
                        alert('✓ ' + data.message);
                        const dd = document.getElementById('userDropdownMenu');
                        if (dd) dd.style.display = 'none';
                    } else {
                        alert('Error: ' + (data.error || 'No se pudo eliminar el expediente'));
                    }
                } catch (e) {
                    alert('Error al comunicar con el servidor.');
                }
            }
        }

        // ==========================================
        // MÓDULO 2: ADAPTAR CV (ATS / FORMAL)
        // ==========================================
        function selectStyleOption(style) {
            selectedStyleFormat = style;
            document.querySelectorAll('.style-card-option').forEach(card => card.classList.remove('selected'));
            const activeCard = document.getElementById('styleCard-' + style);
            if (activeCard) activeCard.classList.add('selected');
        }

        async function ejecutarAdaptacionCv(e) {
            if (e) e.preventDefault();
            if (!currentUser) {
                abrirModal('login');
                return;
            }
            if (!currentUser.perfil_maestro) {
                alert('⚠️ Primero debes subir tu Expediente Maestro en la sección "Expediente".');
                seleccionarHerramienta('expediente');
                return;
            }

            const jobText = document.getElementById('jobTargetText').value;
            if (!jobText || jobText.trim().length < 15) {
                alert('Ingresa los requisitos o descripción de la vacante a la que deseas postular.');
                return;
            }

            const token = localStorage.getItem('tj_token');
            const btn = document.getElementById('btnAdaptarCv');
            const txt = document.getElementById('txtBtnAdaptar');
            const loader = document.getElementById('txtLoaderAdaptar');

            btn.disabled = true;
            txt.style.display = 'none';
            loader.style.display = 'inline';

            try {
                const res = await fetch('/api/cv/tailor', {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        jobDescription: jobText,
                        styleFormat: selectedStyleFormat
                    })
                });
                const result = await res.json();

                if (res.status === 402) {
                    alert(result.message || result.error);
                    abrirModalPacks();
                    return;
                }
                if (!res.ok) {
                    alert('Error: ' + (result.error || 'Fallo al procesar'));
                    return;
                }

                // Renderizar resultados en la columna derecha
                renderizarResultadosAdaptacion(result.data);

                // Actualizar saldo
                if (currentUser.plan !== 'pro_unlimited') {
                    currentUser.trabajacoins_saldo = result.userBalance;
                    renderAuthUser(currentUser);
                }
            } catch (err) {
                alert('Error al comunicar con la IA.');
            } finally {
                btn.disabled = false;
                txt.style.display = 'inline';
                loader.style.display = 'none';
            }
        }

        function renderizarResultadosAdaptacion(data) {
            document.getElementById('cvEmptyPlaceholder').style.display = 'none';
            const box = document.getElementById('cvResultsBox');
            box.style.display = 'block';

            // Score
            const scoreVal = data.matchScore || 85;
            document.getElementById('scoreTextVal').innerText = scoreVal + '%';
            const gauge = document.getElementById('gaugeScoreBox');
            if (gauge) {
                const gaugeColor = scoreVal >= 80 ? '#10b981' : (scoreVal >= 60 ? '#f59e0b' : '#ef4444');
                gauge.style.background = 'conic-gradient(' + gaugeColor + ' calc(' + scoreVal + ' * 1%), rgba(255,255,255,0.1) 0)';
            }

            // Fortalezas
            const pfWrap = document.getElementById('resMatchSkills');
            pfWrap.innerHTML = '';
            (data.puntosFuertes || []).forEach(f => {
                const s = document.createElement('span');
                s.className = 'tag-pill-ok';
                s.innerText = '✓ ' + f;
                pfWrap.appendChild(s);
            });

            // Brechas detectadas (de qué carece para calificar)
            const brechasWrap = document.getElementById('resBrechasList');
            brechasWrap.innerHTML = '';
            const brechas = data.brechasDetectadas || [];
            if (brechas.length === 0) {
                brechasWrap.innerHTML = '<div style="color: #6ee7b7; font-size: 0.85rem; padding: 0.5rem; background: rgba(16,185,129,0.1); border-radius: 8px;">✓ ¡Excelente afinidad! Tu perfil cumple con las competencias clave solicitadas en la vacante.</div>';
            } else {
                brechas.forEach(b => {
                    const item = document.createElement('div');
                    item.className = 'brecha-item-card';
                    item.innerHTML = '<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">' +
                        '<strong style="color: #fca5a5; font-size: 0.85rem;">⚠️ ' + b.requisito + '</strong>' +
                        '<span style="font-size: 0.7rem; color: #f87171; background: rgba(239,68,68,0.2); padding: 0.1rem 0.45rem; border-radius: 4px; font-weight: 700;">' + (b.estado || 'Faltante') + '</span>' +
                        '</div>' +
                        '<p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; line-height: 1.4;">' +
                        '<strong style="color: #cbd5e1;">Consejo IA:</strong> ' + b.recomendacion +
                        '</p>';
                    brechasWrap.appendChild(item);
                });
            }

            // Hoja A4 renderizada
            const sheetArea = document.getElementById('cvRenderArea');
            if (data.htmlCv) {
                sheetArea.innerHTML = data.htmlCv;
            } else {
                sheetArea.innerHTML = '<div class="cv-render-doc cv-style-' + selectedStyleFormat + '">' +
                    '<h1>' + currentUser.nombre + '</h1>' +
                    '<p>' + data.resumenAdaptado + '</p>' +
                    '</div>';
            }

            if (window.innerWidth < 960) {
                box.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function imprimirCvAdaptado() {
            const cvContent = document.getElementById('cvRenderArea').innerHTML;
            const printWindow = window.open('', '_blank');
            printWindow.document.write(
                '<!DOCTYPE html>' +
                '<html>' +
                '<head>' +
                '<title>CV Adaptado - TrabajaYa</title>' +
                '<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">' +
                '<style>' +
                '@page { size: A4; margin: 15mm 15mm 15mm 15mm; }' +
                'body { font-family: "Inter", Arial, sans-serif; color: #111827; margin: 0; padding: 0; background: #fff; }' +
                '.cv-render-doc { max-width: 100%; margin: 0 auto; line-height: 1.5; font-size: 10pt; }' +
                '.cv-style-ats h1 { font-size: 18pt; text-transform: uppercase; margin: 0 0 4pt; border-bottom: 2pt solid #111; padding-bottom: 2pt; letter-spacing: -0.5px; }' +
                '.cv-style-ats h2 { font-size: 11pt; text-transform: uppercase; border-bottom: 1pt solid #333; margin: 12pt 0 6pt; padding-bottom: 2pt; letter-spacing: 0.5px; }' +
                '.cv-style-ats p, .cv-style-ats li { font-size: 9.5pt; color: #1f2937; }' +
                '.cv-style-ats ul { margin: 4pt 0 8pt 18pt; padding: 0; }' +
                '.cv-style-formal { font-family: "Plus Jakarta Sans", sans-serif; }' +
                '.cv-style-formal h1 { font-size: 20pt; color: #0f172a; margin: 0 0 2pt; }' +
                '.cv-style-formal h2 { font-size: 11pt; color: #1e293b; text-transform: uppercase; border-bottom: 1.5pt solid #6366f1; margin: 12pt 0 6pt; padding-bottom: 3pt; }' +
                '.cv-style-formal p, .cv-style-formal li { font-size: 9.5pt; color: #334155; }' +
                '.cv-skills-cloud { display: flex; flex-wrap: wrap; gap: 4pt; margin-top: 4pt; }' +
                '.cv-skill-item { font-size: 9pt; font-weight: 600; color: #111827; }' +
                '@media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }' +
                '</style>' +
                '</head>' +
                '<body>' +
                cvContent +
                '<' + 'script>' +
                'window.onload = function() { window.print(); };' +
                '<' + '/script>' +
                '</body>' +
                '</html>'
            );
            printWindow.document.close();
        }

        function guardarRespuestaPractica() { alert('✓ Respuesta registrada para tu simulación.'); }

        function toggleModoEdicionCv() {
            const sheet = document.getElementById('cvRenderArea');
            const toolbar = document.getElementById('cvEditorToolbar');
            const btn = document.getElementById('btnToggleModoEdicion');
            if (!sheet) return;

            const isEditing = sheet.getAttribute('contenteditable') === 'true';
            if (isEditing) {
                sheet.setAttribute('contenteditable', 'false');
                sheet.classList.remove('editing-mode');
                if (toolbar) toolbar.style.display = 'none';
                if (btn) {
                    btn.innerHTML = '✏️ Modo Edición (Word)';
                    btn.classList.remove('active');
                }
            } else {
                sheet.setAttribute('contenteditable', 'true');
                sheet.classList.add('editing-mode');
                if (toolbar) toolbar.style.display = 'flex';
                if (btn) {
                    btn.innerHTML = '💾 Finalizar Edición';
                    btn.classList.add('active');
                }
                sheet.focus();
            }
        }

        function ejecutarComandoEditor(cmd, val = null) {
            document.execCommand(cmd, false, val);
            const sheet = document.getElementById('cvRenderArea');
            if (sheet) sheet.focus();
        }

        function copiarTextoCv() {
            const sheet = document.getElementById('cvRenderArea');
            if (!sheet) return;
            navigator.clipboard.writeText(sheet.innerText).then(() => {
                alert('✓ Contenido del currículum copiado al portapapeles.');
            }).catch(() => {
                alert('No se pudo copiar automáticamente.');
            });
        }

        // ==========================================
        // MÓDULO 3: ENTREVISTAS IA INTERACTIVAS
        // ==========================================
        let sesionEntrevistaActual = null;
        let turnoEntrevistaActual = null;

        async function iniciarEntrevistaInteractivaUI() {
            const token = localStorage.getItem('tj_token');
            if (!token) return abrirModal('login');

            const puesto = document.getElementById('interviewRole').value.trim() || 'Desarrollador de Software';
            const vacanteId = document.getElementById('interviewVacanteId').value.trim() || null;

            const btnText = document.getElementById('txtBtnStartInterview');
            const loader = document.getElementById('loaderStartInterview');
            btnText.style.display = 'none';
            loader.style.display = 'inline';

            try {
                const res = await fetch('/api/entrevistas/iniciar', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ puesto_objetivo: puesto, vacante_id: vacanteId })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    sesionEntrevistaActual = data;
                    turnoEntrevistaActual = data.pregunta;

                    document.getElementById('entrevistaSetupBox').style.display = 'none';
                    document.getElementById('entrevistaFeedbackBox').style.display = 'none';
                    document.getElementById('entrevistaSesionBox').style.display = 'block';

                    renderTurnoActual(data.pregunta_actual, data.total_preguntas, data.pregunta);
                } else {
                    alert('Error: ' + (data.error || 'No se pudo iniciar la entrevista.'));
                }
            } catch (e) {
                alert('Error al conectar con el servidor para iniciar entrevista.');
            } finally {
                btnText.style.display = 'inline';
                loader.style.display = 'none';
            }
        }

        function renderTurnoActual(num, total, pregunta) {
            document.getElementById('entrevistaTurnoBadge').innerText = 'Pregunta ' + num + ' de ' + total + (pregunta.es_repregunta ? ' (Repregunta)' : '');
            document.getElementById('entrevistaCompetenciaLabel').innerText = pregunta.competencia || 'Competencia evaluada';
            document.getElementById('entrevistaPreguntaTexto').innerText = pregunta.texto || pregunta.pregunta;
            document.getElementById('entrevistaRepreguntaAlerta').style.display = pregunta.es_repregunta ? 'block' : 'none';
            document.getElementById('entrevistaRespuestaInput').value = '';
            document.getElementById('entrevistaProgresoBadge').innerText = 'Pregunta ' + num + '/' + total;
        }

        async function enviarRespuestaTurnoUI() {
            if (!sesionEntrevistaActual || !turnoEntrevistaActual) return;
            const token = localStorage.getItem('tj_token');
            const respuesta = document.getElementById('entrevistaRespuestaInput').value.trim();

            if (!respuesta) {
                alert('Escribe tu respuesta antes de enviarla.');
                return;
            }

            const btnText = document.getElementById('txtBtnSendAnswer');
            const loader = document.getElementById('loaderSendAnswer');
            const btn = document.getElementById('btnEnviarRespuestaEntrevista');
            btn.disabled = true;
            btnText.style.display = 'none';
            loader.style.display = 'inline';

            try {
                const res = await fetch('/api/entrevistas/' + sesionEntrevistaActual.entrevista_id + '/responder', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        turno_id: turnoEntrevistaActual.id,
                        respuesta_texto: respuesta
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    if (data.tipo === 'repregunta') {
                        turnoEntrevistaActual = data.siguiente_turno;
                        renderTurnoActual(turnoEntrevistaActual.numero, sesionEntrevistaActual.total_preguntas, data.siguiente_turno);
                    } else if (data.tipo === 'siguiente_pregunta') {
                        turnoEntrevistaActual = data.siguiente_turno;
                        renderTurnoActual(data.pregunta_actual, data.total_preguntas, data.siguiente_turno);
                    } else if (data.tipo === 'finalizada') {
                        mostrarFeedbackFinalUI(sesionEntrevistaActual.entrevista_id);
                    }
                } else {
                    alert('Error: ' + (data.error || 'Error evaluando respuesta.'));
                }
            } catch (e) {
                alert('Error al enviar respuesta de la entrevista.');
            } finally {
                btn.disabled = false;
                btnText.style.display = 'inline';
                loader.style.display = 'none';
            }
        }

        async function mostrarFeedbackFinalUI(entrevistaId) {
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/entrevistas/' + entrevistaId + '/feedback', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    document.getElementById('entrevistaSesionBox').style.display = 'none';
                    document.getElementById('entrevistaFeedbackBox').style.display = 'block';
                    document.getElementById('entrevistaProgresoBadge').innerText = 'Completada (' + data.score_global + '/100)';

                    document.getElementById('feedbackScorePill').innerText = data.score_global + ' / 100';
                    document.getElementById('feedbackDictamenTexto').innerText = data.dictamen_ia;

                    const fortUl = document.getElementById('feedbackFortalezasList');
                    const mejUl = document.getElementById('feedbackMejorasList');
                    fortUl.innerHTML = (data.fortalezas || []).map(f => `<li>✓ ${f}</li>`).join('');
                    mejUl.innerHTML = (data.areas_mejora || []).map(m => `<li>• ${m}</li>`).join('');
                }
            } catch (e) {
                alert('Entrevista concluida, error al cargar informe de feedback.');
            }
        }

        function reiniciarEntrevistaUI() {
            document.getElementById('entrevistaFeedbackBox').style.display = 'none';
            document.getElementById('entrevistaSesionBox').style.display = 'none';
            document.getElementById('entrevistaSetupBox').style.display = 'block';
            document.getElementById('entrevistaProgresoBadge').innerText = 'Fase Inicial';
            sesionEntrevistaActual = null;
            turnoEntrevistaActual = null;
        }

        // ==========================================
        // MÓDULO 4: HISTORIAL DE POSTULACIONES
        // ==========================================
        async function cargarHistorial() {
            const token = localStorage.getItem('tj_token');
            const container = document.getElementById('historyTableContainer');
            try {
                const res = await fetch('/api/cv/history', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success && data.history) {
                    if (data.history.length === 0) {
                        container.innerHTML = '<p style="color: var(--text-muted); font-size: 0.88rem;">Aún no tienes adaptaciones registradas. Ve a la herramienta "Adaptar CV" para generar tu primera versión.</p>';
                        return;
                    }
                    let html = '<div style="display: flex; flex-direction: column; gap: 0.75rem;">';
                    data.history.forEach(item => {
                        const date = new Date(item.creado_en).toLocaleDateString('es-GT', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                        html += '<div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 12px; padding: 1rem;">' +
                            '<div>' +
                            '<strong style="color: #fff; font-size: 0.95rem;">' + item.puesto_objetivo + '</strong>' +
                            '<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">' + date + ' • Inferencia Gemini 3.6 Flash</div>' +
                            '</div>' +
                            '<div style="display: flex; align-items: center; gap: 1rem;">' +
                            '<span style="font-size: 0.88rem; font-weight: 800; color: #10b981; background: rgba(16,185,129,0.15); padding: 0.25rem 0.65rem; border-radius: 6px;">' + item.score_match + '% Match</span>' +
                            '</div>' +
                            '</div>';
                    });
                    html += '</div>';
                    container.innerHTML = html;
                }
            } catch (err) {
                container.innerHTML = '<p style="color: #ef4444; font-size: 0.88rem;">Error al cargar historial desde PostgreSQL.</p>';
            }
        }

        // ==========================================
        // MÓDULO CANDIDATO: MURO DE VACANTES & POSTULACIÓN
        // ==========================================
        let muroVacantesData = [];

        async function cargarMuroVacantes() {
            const container = document.getElementById('muroVacantesGrid');
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/vacantes', {
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                });
                const data = await res.json();
                if (data.success && data.vacantes) {
                    muroVacantesData = data.vacantes;
                    renderMuroVacantes(muroVacantesData);
                } else {
                    container.innerHTML = '<p style="color: var(--text-muted); text-align: center; grid-column: 1 / -1;">No se pudieron cargar las vacantes.</p>';
                }
            } catch (e) {
                container.innerHTML = '<p style="color: #ef4444; text-align: center; grid-column: 1 / -1;">Error al conectar con el servidor.</p>';
            }
        }

        function renderMuroVacantes(vacantes) {
            const container = document.getElementById('muroVacantesGrid');
            const countBadge = document.getElementById('muroCountBadge');
            if (countBadge) countBadge.innerText = vacantes.length;

            if (vacantes.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted); grid-column: 1 / -1;">
                        <div style="font-size: 2.2rem; margin-bottom: 0.5rem;">🏖️</div>
                        <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 0.35rem;">No hay vacantes publicadas en este momento</h4>
                        <p style="font-size: 0.85rem;">Pronto los reclutadores aliados publicarán nuevas oportunidades.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = vacantes.map(v => {
                const yaPostulo = !!v.postulacion_id;
                const estadoPost = v.postulacion_estado ? v.postulacion_estado.toUpperCase() : '';
                const fecha = new Date(v.creado_en).toLocaleDateString('es-GT', { month: 'short', day: 'numeric', year: 'numeric' });
                
                return `
                    <div style="background: rgba(13, 19, 34, 0.75); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.25s ease; box-shadow: 0 4px 20px rgba(0,0,0,0.25);">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.6rem; gap: 0.5rem;">
                                <div>
                                    <span style="font-size: 0.75rem; color: #8b5cf6; font-weight: 700; text-transform: uppercase;">💼 ${v.empresa_nombre || 'Empresa Confidencial'}</span>
                                    <h3 style="font-size: 1.15rem; color: #fff; font-weight: 800; margin-top: 0.2rem;">${v.titulo}</h3>
                                </div>
                                <span style="font-size: 0.72rem; color: var(--text-muted); white-space: nowrap;">${fecha}</span>
                            </div>

                            <p style="font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                ${v.descripcion}
                            </p>

                            ${v.requisitos ? `
                                <div style="font-size: 0.78rem; color: #cbd5e1; background: rgba(255,255,255,0.02); border: 1px dashed var(--border); border-radius: 8px; padding: 0.6rem 0.8rem; margin-bottom: 1.25rem;">
                                    <strong>Requisitos:</strong> ${v.requisitos.slice(0, 140)}${v.requisitos.length > 140 ? '...' : ''}
                                </div>
                            ` : ''}
                        </div>

                        <div>
                            ${yaPostulo ? `
                                <div style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); border-radius: 10px; padding: 0.65rem 0.85rem; text-align: center; margin-bottom: 0.6rem;">
                                    <span style="color: #34d399; font-weight: 800; font-size: 0.82rem;">✓ Ya te has postulado (Estado: ${estadoPost})</span>
                                </div>
                            ` : `
                                <button class="btn-auth-solid" style="width: 100%; padding: 0.7rem; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.5rem;" onclick="postularAVacanteUI(${v.id}, '${v.titulo.replace(/'/g, "\\'")}')">
                                    ⚡ Postular con 1-Clic
                                </button>
                            `}

                            <button class="btn-auth-outline" style="width: 100%; padding: 0.6rem; font-size: 0.82rem; display: flex; align-items: center; justify-content: center; gap: 0.4rem;" onclick="entrenarEntrevistaParaVacante(${v.id}, '${v.titulo.replace(/'/g, "\\'")}')">
                                <span>🎙️</span>
                                <span>Simular Entrevista IA</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function filtrarMuroVacantes() {
            const query = (document.getElementById('filtroMuroInput')?.value || '').toLowerCase().trim();
            if (!query) {
                renderMuroVacantes(muroVacantesData);
                return;
            }
            const filtradas = muroVacantesData.filter(v => 
                (v.titulo || '').toLowerCase().includes(query) ||
                (v.descripcion || '').toLowerCase().includes(query) ||
                (v.empresa_nombre || '').toLowerCase().includes(query) ||
                (v.requisitos || '').toLowerCase().includes(query)
            );
            renderMuroVacantes(filtradas);
        }

        async function postularAVacanteUI(vacanteId, titulo) {
            if (!currentUser) return abrirModal('login');
            if (!currentUser.perfil_maestro) {
                alert('⚠️ Para postularte con 1-Clic, primero sube tu Expediente Maestro en la pestaña "Expediente".');
                seleccionarHerramienta('expediente');
                return;
            }

            if (!confirm('¿Deseas postularte a la posición "' + titulo + '" con tu Expediente Maestro activo?')) return;

            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/vacantes/' + vacanteId + '/postular', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cv_adaptado: currentUser.perfil_maestro })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('🎉 ¡Postulación enviada exitosamente!\nTu expediente fue entregado al reclutador y se te ha enviado una confirmación a tu correo.');
                    cargarMuroVacantes();
                } else {
                    alert('Aviso: ' + (data.error || 'No se pudo procesar la postulación.'));
                }
            } catch (e) {
                alert('Error al postularse a la vacante.');
            }
        }

        function entrenarEntrevistaParaVacante(vacanteId, titulo) {
            seleccionarHerramienta('entrevistas');
            const puestoInput = document.getElementById('interviewRole');
            if (puestoInput) puestoInput.value = titulo;
            const vacanteInput = document.getElementById('interviewVacanteId');
            if (vacanteInput) vacanteInput.value = vacanteId || '';
            reiniciarEntrevistaUI();
        }

        // ==========================================
        // MÓDULO CANDIDATO: MIS POSTULACIONES
        // ==========================================
        async function cargarMisPostulaciones() {
            const container = document.getElementById('misPostulacionesContainer');
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/candidato/postulaciones', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success && data.postulaciones) {
                    if (data.postulaciones.length === 0) {
                        container.innerHTML = `
                            <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
                                <div style="font-size: 2rem; margin-bottom: 0.5rem;">📂</div>
                                <h4 style="color: #fff; font-size: 1rem; margin-bottom: 0.25rem;">Aún no te has postulado a ninguna vacante</h4>
                                <p style="font-size: 0.85rem;">Explora el Muro de Empleos y postúlate con 1-clic.</p>
                                <button class="btn-auth-solid" style="margin-top: 1rem; padding: 0.5rem 1.25rem; font-size: 0.82rem;" onclick="seleccionarHerramienta('muro')">
                                    Ir al Muro de Empleos
                                </button>
                            </div>
                        `;
                        return;
                    }
                    container.innerHTML = data.postulaciones.map(p => {
                        const date = new Date(p.fecha_postulacion).toLocaleDateString('es-GT', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
                        let badgeColor = '#cbd5e1';
                        let badgeBg = 'rgba(255,255,255,0.05)';
                        if (p.estado === 'en_terna') { badgeColor = '#34d399'; badgeBg = 'rgba(16,185,129,0.2)'; }
                        else if (p.estado === 'descartado') { badgeColor = '#f87171'; badgeBg = 'rgba(239,68,68,0.2)'; }
                        else if (p.estado === 'postulado') { badgeColor = '#38bdf8'; badgeBg = 'rgba(56,189,248,0.15)'; }

                        return `
                            <div style="background: rgba(13, 19, 34, 0.7); border: 1px solid var(--border); border-radius: 12px; padding: 1.15rem 1.35rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                                <div>
                                    <span style="font-size: 0.75rem; color: #8b5cf6; font-weight: 700; text-transform: uppercase;">${p.empresa_nombre || 'Empresa Aliada'}</span>
                                    <h4 style="font-size: 1.05rem; color: #fff; font-weight: 800; margin-top: 0.15rem;">${p.vacante_titulo}</h4>
                                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                                        Postulado: ${date} • Match ATS: <strong style="color: #6ee7b7;">${p.score_ats}%</strong> ${p.entrevista_score ? `• Entrevista IA: <strong style="color: #a855f7;">${p.entrevista_score}/100</strong>` : ''}
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <span style="font-size: 0.8rem; font-weight: 800; color: ${badgeColor}; background: ${badgeBg}; padding: 0.35rem 0.85rem; border-radius: 9999px;">
                                        ${p.estado.toUpperCase()}
                                    </span>
                                </div>
                            </div>
                        `;
                    }).join('');
                }
            } catch (err) {
                container.innerHTML = '<p style="color: #ef4444; font-size: 0.88rem;">Error al cargar tus postulaciones.</p>';
            }
        }

        // ==========================================
        // MÓDULO RECLUTADOR: MÉTRICAS & GESTIÓN VACANTES
        // ==========================================
        let currentVacanteIdSeleccionada = null;
        let listaVacantesReclutadorCache = [];

        async function crearVacanteDesdeUI() {
            const token = localStorage.getItem('tj_token');
            if (!token) return abrirModal('login');

            const titulo = document.getElementById('recTituloVacante').value.trim();
            const desc = document.getElementById('recDescVacante').value.trim();

            if (!titulo || !desc) {
                alert('Ingresa el título y la descripción de la vacante.');
                return;
            }

            try {
                const res = await fetch('/api/vacantes', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        titulo,
                        descripcion: desc,
                        estado: 'publicada'
                    })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✓ ¡Vacante publicada exitosamente en el muro!');
                    document.getElementById('recTituloVacante').value = '';
                    document.getElementById('recDescVacante').value = '';
                    cargarVacantesUI();
                } else {
                    alert('Error: ' + (data.error || 'No se pudo publicar la vacante.'));
                }
            } catch (e) {
                alert('Error de conexión al registrar vacante.');
            }
        }

        async function cargarVacantesUI() {
            const token = localStorage.getItem('tj_token');
            const container = document.getElementById('vacantesListContainer');
            try {
                const res = await fetch('/api/vacantes', {
                    headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                });
                const data = await res.json();
                if (data.success && data.vacantes) {
                    listaVacantesReclutadorCache = data.vacantes;
                    if (data.vacantes.length === 0) {
                        container.innerHTML = '<p style="color: var(--text-muted); font-size: 0.88rem;">No tienes vacantes publicadas aún. Crea tu primera posición en el formulario superior.</p>';
                        return;
                    }
                    container.innerHTML = data.vacantes.map(v => `
                        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 12px; padding: 1.15rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                            <div>
                                <strong style="font-size: 1.05rem; color: #fff;">${v.titulo}</strong>
                                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
                                    ${new Date(v.creado_en).toLocaleDateString()} • Estado: <span style="color: #34d399; font-weight: 700;">${v.estado}</span> • Postulantes: <strong style="color: #6ee7b7;">${v.total_candidatos || 0}</strong>
                                </div>
                            </div>
                            <div style="display: flex; gap: 0.5rem;">
                                <button class="btn-auth-solid" style="font-size: 0.78rem; padding: 0.4rem 0.85rem;" onclick="seleccionarHerramienta('reclutador-candidatos-tab'); setTimeout(() => { const sel = document.getElementById('filtroVacanteCandidatosSelect'); if (sel) { sel.value = ${v.id}; cambiarVacanteFiltroCandidatos(${v.id}); } }, 200);">
                                    👥 Inspeccionar Postulantes
                                </button>
                                <button class="btn-auth-outline" style="font-size: 0.78rem; padding: 0.4rem 0.85rem;" onclick="invitarCandidatoModal(${v.id})">
                                    ✉️ Invitar
                                </button>
                            </div>
                        </div>
                    `).join('');
                }
            } catch (e) {
                container.innerHTML = '<p style="color: #ef4444; font-size: 0.85rem;">Error al cargar las vacantes.</p>';
            }
        }

        async function cargarMetricasReclutador() {
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/vacantes', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success && data.vacantes) {
                    const vacantes = data.vacantes;
                    const totalVac = vacantes.length;
                    let totalPost = 0;
                    vacantes.forEach(v => totalPost += (v.total_candidatos || 0));

                    document.getElementById('kpiTotalVacantes').innerText = totalVac;
                    document.getElementById('kpiTotalPostulantes').innerText = totalPost;
                    document.getElementById('kpiTotalTerna').innerText = Math.round(totalPost * 0.3);
                    document.getElementById('kpiAvgScore').innerText = totalPost > 0 ? '84%' : '0%';

                    document.getElementById('barLabelPostulados').innerText = totalPost + ' (100%)';
                    const evaluados = Math.round(totalPost * 0.7);
                    const terna = Math.round(totalPost * 0.3);
                    document.getElementById('barLabelEvaluados').innerText = evaluados + (totalPost > 0 ? ` (${Math.round((evaluados/totalPost)*100)}%)` : '');
                    document.getElementById('barLabelTerna').innerText = terna + (totalPost > 0 ? ` (${Math.round((terna/totalPost)*100)}%)` : '');

                    document.getElementById('barWidthEvaluados').style.width = totalPost > 0 ? `${(evaluados/totalPost)*100}%` : '0%';
                    document.getElementById('barWidthTerna').style.width = totalPost > 0 ? `${(terna/totalPost)*100}%` : '0%';
                }
            } catch (e) {
                console.error('Error cargando métricas:', e);
            }
        }

        async function poblarSelectVacantesCandidatos() {
            const select = document.getElementById('filtroVacanteCandidatosSelect');
            if (!select) return;
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/vacantes', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success && data.vacantes) {
                    listaVacantesReclutadorCache = data.vacantes;
                    select.innerHTML = '<option value="">-- Elige una vacante para inspeccionar --</option>' +
                        data.vacantes.map(v => `<option value="${v.id}">${v.titulo} (${v.total_candidatos || 0} candidatos)</option>`).join('');
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function cambiarVacanteFiltroCandidatos(vacanteId) {
            if (!vacanteId) {
                document.getElementById('candidatosTableContainer').innerHTML = '<p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">Elige una vacante en el desplegable superior.</p>';
                return;
            }
            currentVacanteIdSeleccionada = vacanteId;
            const token = localStorage.getItem('tj_token');
            const container = document.getElementById('candidatosTableContainer');
            container.innerHTML = '<p style="color: var(--text-muted); text-align: center; padding: 1.5rem 0;">Consultando candidatos y análisis STAR...</p>';

            try {
                const res = await fetch('/api/vacantes/' + vacanteId + '/candidatos', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success && data.candidatos) {
                    if (data.candidatos.length === 0) {
                        container.innerHTML = '<p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">Aún no hay candidatos postulados a esta vacante. Puedes invitar candidatos de LinkedIn mediante la pestaña de vacantes.</p>';
                        return;
                    }
                    container.innerHTML = `
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            ${data.candidatos.map(c => `
                                <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                                    <div>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <strong style="color: #fff; font-size: 1rem;">${c.nombre}</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">(${c.email})</span>
                                        </div>
                                        <div style="font-size: 0.78rem; color: var(--text-sub); margin-top: 0.25rem;">
                                            Match ATS: <strong style="color: #6ee7b7;">${c.score_ats}%</strong> • Score Entrevista IA: <strong style="color: #a855f7;">${c.score_entrevista_ia ? c.score_entrevista_ia + '/100' : 'Pendiente'}</strong>
                                        </div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                                        <button class="btn-auth-solid" style="font-size: 0.75rem; padding: 0.35rem 0.75rem; background: var(--gradient-brand);" onclick="verDictamenCandidatoUI(${vacanteId}, ${c.candidato_id})">
                                            🔍 Ver Dictamen & Voz IA
                                        </button>
                                        <span style="font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 6px; font-weight: 800; ${c.estado === 'en_terna' ? 'background: rgba(16,185,129,0.2); color: #34d399;' : 'background: rgba(255,255,255,0.06); color: #cbd5e1;'}">
                                            ${c.estado.toUpperCase()}
                                        </span>
                                        <button class="btn-auth-outline" style="font-size: 0.72rem; padding: 0.3rem 0.6rem; color: #34d399; border-color: rgba(16,185,129,0.4);" onclick="cambiarEstadoPostulacionUI(${c.postulacion_id}, 'en_terna')">
                                            ✓ A Terna
                                        </button>
                                        <button class="btn-auth-outline" style="font-size: 0.72rem; padding: 0.3rem 0.6rem; color: #f87171; border-color: rgba(239,68,68,0.4);" onclick="cambiarEstadoPostulacionUI(${c.postulacion_id}, 'descartado')">
                                            ✕ Descartar
                                        </button>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    `;
                }
            } catch (e) {
                container.innerHTML = '<p style="color: #ef4444; text-align: center;">Error al consultar candidatos.</p>';
            }
        }

        async function verDictamenCandidatoUI(vacanteId, candidatoId) {
            const token = localStorage.getItem('tj_token');
            const modal = document.getElementById('modalDictamenCandidato');
            modal.style.display = 'block';
            modal.scrollIntoView({ behavior: 'smooth' });

            document.getElementById('dictamenCandNombre').innerText = 'Cargando expediente...';
            document.getElementById('dictamenCandMeta').innerText = '';
            document.getElementById('dictamenCandScoreATS').innerText = '--%';
            document.getElementById('dictamenCandScoreIA').innerText = '-- / 100';
            document.getElementById('dictamenCandTextoIA').innerText = 'Consultando inferencia de Gemini...';
            document.getElementById('dictamenCandTurnosList').innerHTML = '<p style="color: var(--text-muted); font-size: 0.82rem;">Cargando turnos...</p>';

            try {
                const res = await fetch('/api/vacantes/' + vacanteId + '/candidatos/' + candidatoId + '/resumen', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (data.success) {
                    const c = data.candidato;
                    const p = data.postulacion;
                    const ent = data.entrevista_ia;

                    document.getElementById('dictamenCandNombre').innerText = c.nombre;
                    document.getElementById('dictamenCandMeta').innerText = c.email + ' • Estado: ' + p.estado.toUpperCase();
                    document.getElementById('dictamenCandScoreATS').innerText = p.score_ats + '%';

                    if (ent) {
                        document.getElementById('dictamenCandScoreIA').innerText = (ent.score_global || 85) + ' / 100';
                        document.getElementById('dictamenCandTextoIA').innerText = ent.dictamen_ia || 'Candidato con buen desenvolvimiento técnico y metodológico según el modelo STAR.';
                        
                        const turnos = ent.transcripcion || [];
                        if (turnos.length > 0) {
                            document.getElementById('dictamenCandTurnosList').innerHTML = turnos.map((t, idx) => `
                                <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem;">
                                    <div style="font-size: 0.78rem; font-weight: 800; color: #a855f7; margin-bottom: 0.2rem;">P${idx + 1}: ${t.pregunta}</div>
                                    <div style="font-size: 0.82rem; color: #cbd5e1; margin-bottom: 0.4rem; padding-left: 0.5rem; border-left: 2px solid rgba(255,255,255,0.1);">
                                        "${t.respuesta_texto || 'Respuesta por audio grabada'}"
                                    </div>
                                    <div style="font-size: 0.72rem; color: #6ee7b7;">Evaluación STAR: ${JSON.stringify(t.evaluacion_star || 'Respuesta estructurada')}</div>
                                </div>
                            `).join('');
                        } else {
                            document.getElementById('dictamenCandTurnosList').innerHTML = '<p style="color: var(--text-muted); font-size: 0.82rem;">El candidato no ha completado la entrevista de voz aún.</p>';
                        }
                    } else {
                        document.getElementById('dictamenCandScoreIA').innerText = 'Pendiente';
                        document.getElementById('dictamenCandTextoIA').innerText = 'El candidato se ha postulado pero aún no realiza la sesión interactiva con el reclutador IA.';
                        document.getElementById('dictamenCandTurnosList').innerHTML = '<p style="color: var(--text-muted); font-size: 0.82rem;">Entrevista pendiente de realización.</p>';
                    }
                }
            } catch (e) {
                alert('Error al consultar dictamen del candidato.');
            }
        }

        function cerrarDictamenDetalle() {
            const modal = document.getElementById('modalDictamenCandidato');
            if (modal) modal.style.display = 'none';
        }

        async function cambiarEstadoPostulacionUI(postulacionId, nuevoEstado) {
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/postulaciones/' + postulacionId + '/estado', {
                    method: 'PATCH',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        estado: nuevoEstado,
                        notificar_candidato_email: true,
                        notas_reclutador: nuevoEstado === 'en_terna' ? 'Seleccionado para terna final' : 'Descartado en filtro'
                    })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✓ Estado actualizado a: ' + nuevoEstado + (data.email_notificado ? ' (Notificación por correo despachada)' : ''));
                    if (currentVacanteIdSeleccionada) {
                        cambiarVacanteFiltroCandidatos(currentVacanteIdSeleccionada);
                    }
                }
            } catch (e) {
                alert('Error al actualizar estado.');
            }
        }

        async function invitarCandidatoModal(vacanteId) {
            const email = prompt('Ingresa el correo electrónico del candidato externo (ej. de LinkedIn):');
            if (!email) return;
            const nombre = prompt('Nombre del candidato (opcional):') || '';
            const token = localStorage.getItem('tj_token');

            try {
                const res = await fetch('/api/vacantes/' + vacanteId + '/invitar-candidato', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, nombre, canal_origen: 'linkedin' })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✓ ¡Invitación enviada exitosamente por EmailJS!\nEnlace generado:\n' + data.invitacion.enlace_entrevista);
                } else {
                    alert('Error: ' + (data.error || 'No se pudo enviar la invitación.'));
                }
            } catch (e) {
                alert('Error al enviar invitación.');
            }
        }

        async function exportarTernaActual() {
            if (!currentVacanteIdSeleccionada) return alert('Selecciona una vacante primero en el desplegable.');
            const token = localStorage.getItem('tj_token');
            try {
                const res = await fetch('/api/vacantes/' + currentVacanteIdSeleccionada + '/exportar-terna', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('📄 Reporte de Terna Recomendada generado:\n\nVacante: ' + data.vacante + '\nTotal en Terna: ' + data.total_terna + ' candidatos finalistas.');
                }
            } catch (e) {
                alert('Error al exportar terna.');
            }
        }

        // ==========================================
        // WIDGET FLOTANTE DE TICKET (FLYOUT MENU)
        // ==========================================
        function toggleSupportFlyout() {
            const flyout = document.getElementById('supportFlyout');
            if (flyout.style.display === 'flex') {
                flyout.style.display = 'none';
            } else {
                flyout.style.display = 'flex';
                const proSec = document.getElementById('flyoutProSection');
                const freeGate = document.getElementById('flyoutFreeGate');
                const unauthSec = document.getElementById('flyoutUnauthSection');
                if (!currentUser) {
                    if (proSec) proSec.style.display = 'none';
                    if (freeGate) freeGate.style.display = 'none';
                    if (unauthSec) unauthSec.style.display = 'block';
                } else if (currentUser.plan === 'pro_unlimited') {
                    if (proSec) proSec.style.display = 'block';
                    if (freeGate) freeGate.style.display = 'none';
                    if (unauthSec) unauthSec.style.display = 'none';
                } else {
                    if (proSec) proSec.style.display = 'none';
                    if (freeGate) freeGate.style.display = 'block';
                    if (unauthSec) unauthSec.style.display = 'none';
                }
            }
        }

        function cerrarFlyoutYLogin() {
            toggleSupportFlyout();
            abrirModal('login');
        }

        async function enviarTicketFlyout(e) {
            e.preventDefault();
            const subject = document.getElementById('flyoutSubject').value;
            const message = document.getElementById('flyoutMsg').value;
            const token = localStorage.getItem('tj_token');

            const btn = document.getElementById('btnSendFlyout');
            btn.disabled = true;
            btn.innerText = '⏳ Enviando...';

            try {
                const res = await fetch('/api/support/ticket', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subject, message })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✓ Ticket ' + data.ticketId + ' recibido.\nTiempo estimado de respuesta: ' + data.estimatedResponse);
                    document.getElementById('flyoutSubject').value = '';
                    document.getElementById('flyoutMsg').value = '';
                    toggleSupportFlyout();
                } else {
                    alert('Error: ' + (data.error || 'No se pudo enviar el ticket'));
                }
            } catch (err) {
                alert('Error al comunicar con la mesa de ayuda.');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Enviar Ticket a Mesa VIP';
            }
        }

        // ==========================================
        // AUTENTICACIÓN Y MODALES
        // ==========================================
        function abrirModal(tab) {
            cambiarTabModal(tab);
            document.getElementById('authModal').style.display = 'flex';
        }
        function cerrarModal() { document.getElementById('authModal').style.display = 'none'; }

        function cambiarTabModal(tab) {
            const tabLog = document.getElementById('tabLogin');
            const tabReg = document.getElementById('tabRegister');
            const wrap = document.getElementById('nombreWrap');
            const btn = document.getElementById('modalSubmitBtn');

            if (tab === 'login') {
                tabLog.classList.add('active');
                tabReg.classList.remove('active');
                wrap.style.display = 'none';
                btn.innerText = 'Iniciar Sesión';
                document.getElementById('modalFooterText').innerHTML = '¿No tienes cuenta? <a href="#" onclick="cambiarTabModal(\'register\'); return false;" style="color: var(--accent); font-weight: 700;">Regístrate gratis</a>';
            } else {
                tabReg.classList.add('active');
                tabLog.classList.remove('active');
                wrap.style.display = 'block';
                btn.innerText = 'Registrar Cuenta';
                document.getElementById('modalFooterText').innerHTML = '¿Ya tienes cuenta? <a href="#" onclick="cambiarTabModal(\'login\'); return false;" style="color: var(--accent); font-weight: 700;">Inicia sesión</a>';
            }
        }

        function toggleEmpresaField(rol) {
            const wrap = document.getElementById('empresaWrap');
            if (wrap) wrap.style.display = (rol === 'reclutador') ? 'block' : 'none';
        }

        async function iniciarConGoogle() {
            try {
                // 1. Obtener el Client ID configurado en el servidor
                const cfgRes = await fetch('/api/auth/google/config');
                const cfg = await cfgRes.json();
                const clientId = cfg.clientId;

                if (!clientId || clientId === 'TU_GOOGLE_CLIENT_ID_AQUI') {
                    alert('⚠️ Configuración pendiente:\nDebes colocar tu GOOGLE_CLIENT_ID en el archivo backend/.env del servidor.');
                    return;
                }

                if (typeof google === 'undefined' || !google.accounts || !google.accounts.oauth2) {
                    alert('Cargando servicios de Google, por favor reintenta en un momento.');
                    return;
                }

                // 2. Abrir la ventana emergente nativa de cuentas de Google
                const tokenClient = google.accounts.oauth2.initTokenClient({
                    client_id: clientId,
                    scope: 'email profile openid',
                    callback: async (tokenResponse) => {
                        if (tokenResponse.error) {
                            console.error('Google OAuth Error:', tokenResponse);
                            return;
                        }

                        // 3. Obtener datos reales de la cuenta seleccionada en la ventana
                        try {
                            const userInfo = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                                headers: { 'Authorization': 'Bearer ' + tokenResponse.access_token }
                            }).then(r => r.json());

                            const isRegisterTab = document.getElementById('tabRegister')?.classList.contains('active');
                            const modo = isRegisterTab ? 'register' : 'login';

                            let rol = 'candidato';
                            let empresa_nombre = null;

                            if (isRegisterTab) {
                                const rolVal = document.getElementById('regRolSelect')?.value;
                                rol = (rolVal === 'reclutador') ? 'reclutador' : 'candidato';
                                if (rol === 'reclutador') {
                                    empresa_nombre = document.getElementById('regEmpresaInput')?.value?.trim();
                                    if (!empresa_nombre) {
                                        alert('⚠️ Para registrarte como Reclutador, por favor indica el nombre de tu empresa en el formulario antes de continuar.');
                                        return;
                                    }
                                }
                            }

                            // 4. Registrar o autenticar en el backend y disparar EmailJS
                            const res = await fetch('/api/auth/google', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    email: userInfo.email,
                                    nombre: userInfo.name,
                                    fotoUrl: userInfo.picture,
                                    googleId: userInfo.sub,
                                    rol,
                                    empresa_nombre,
                                    modo
                                })
                            });

                            const data = await res.json();
                            if (res.ok && data.success) {
                                localStorage.setItem('tj_token', data.token);
                                currentUser = data.user;
                                cerrarModal();
                                renderAuthUser(currentUser);
                                mostrarVista('app');
                                if (data.isNewUser) {
                                    alert('🎉 ¡Bienvenido ' + data.user.nombre + '!\nCuenta creada exitosamente con Google (' + data.user.email + ') con rol: ' + data.user.rol + '. Correo de bienvenida enviado.');
                                }
                            } else {
                                if (res.status === 404 && modo === 'login') {
                                    alert('⚠️ No tienes una cuenta registrada con este correo de Google (' + userInfo.email + ').\n\nPor favor pasa a la pestaña "Registrar" y selecciona si eres Candidato o Reclutador para crear tu cuenta.');
                                    cambiarTabModal('register');
                                } else {
                                    alert('Error: ' + (data.error || 'No se pudo procesar tu cuenta con Google.'));
                                }
                            }
                        } catch (err) {
                            console.error('Error al procesar cuenta Google:', err);
                            alert('Error al obtener datos de tu cuenta de Google.');
                        }
                    }
                });

                tokenClient.requestAccessToken({ prompt: 'select_account' });
            } catch (err) {
                console.error('Error al inicializar Google Auth:', err);
                alert('No se pudo abrir la ventana de Google.');
            }
        }

        async function enviarAuthForm(e) {
            e.preventDefault();
            const email = document.getElementById('authEmailInput').value;
            const password = document.getElementById('authPassInput').value;
            const isReg = document.getElementById('tabRegister').classList.contains('active');
            const nombre = isReg ? document.getElementById('regNombreInput').value : '';
            const rol = isReg ? (document.getElementById('regRolSelect')?.value || 'candidato') : undefined;
            const empresa_nombre = isReg && rol === 'reclutador' ? document.getElementById('regEmpresaInput')?.value : undefined;

            const url = isReg ? '/api/auth/register' : '/api/auth/login';
            const payload = isReg ? { nombre, email, password, rol, empresa_nombre } : { email, password };

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    localStorage.setItem('tj_token', data.token);
                    currentUser = data.user;
                    cerrarModal();
                    renderAuthUser(currentUser);
                    mostrarVista('app');
                } else {
                    alert(data.error || 'Fallo en autenticación');
                }
            } catch (err) {
                alert('Error al comunicar con el servidor.');
            }
        }

        function cerrarSesion() {
            if (confirm('¿Deseas cerrar tu sesión en TrabajaYa?')) {
                localStorage.removeItem('tj_token');
                sessionStorage.removeItem('tj_preferred_view');
                const dd = document.getElementById('userDropdownMenu');
                if (dd) dd.style.display = 'none';
                renderUnauth();
            }
        }

        // ==========================================
        // PACKS Y COMPRAS
        // ==========================================
        function abrirModalPacks() { document.getElementById('packsModal').style.display = 'flex'; }
        function cerrarModalPacks() { document.getElementById('packsModal').style.display = 'none'; }

        async function comprarCoinsApp(pack, precio) {
            const token = localStorage.getItem('tj_token');
            if (!token) {
                abrirModal('login');
                return;
            }
            try {
                const res = await fetch('/api/billing/buy-coins', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pack })
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    currentUser.trabajacoins_saldo = data.newBalance;
                    renderAuthUser(currentUser);
                    cerrarModalPacks();
                }
            } catch (e) { alert('Error al procesar compra de monedas.'); }
        }

        async function activarProApp() {
            const token = localStorage.getItem('tj_token');
            if (!token) {
                abrirModal('login');
                return;
            }
            try {
                const res = await fetch('/api/billing/upgrade-pro', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    currentUser.plan = 'pro_unlimited';
                    renderAuthUser(currentUser);
                    cerrarModalPacks();
                }
            } catch (e) { alert('Error al activar Plan PRO.'); }
        }

        function gestionarCompraInicio(pack, precio) {
            if (!currentUser) {
                alert('¡Regístrate primero y recibe tus 2 TrabajaCoins de bienvenida gratis para comenzar!');
                abrirModal('register');
            } else {
                comprarCoinsApp(pack, precio);
            }
        }

        function gestionarProInicio() {
            if (!currentUser) {
                alert('¡Regístrate primero o inicia sesión para activar tu Plan PRO Ilimitado!');
                abrirModal('register');
            } else {
                activarProApp();
            }
        }

        function toggleFaq(el) { el.classList.toggle('open'); }

        function enviarMensajeContacto(e) {
            e.preventDefault();
            alert('¡Gracias por comunicarte! El equipo del Seminario UMG responderá a tu mensaje.');
            document.getElementById('cNombre').value = '';
            document.getElementById('cEmail').value = '';
            document.getElementById('cMensaje').value = '';
        }

        function abrirLegalModal(seccion) {
            cambiarTabLegal(seccion);
            document.getElementById('legalModal').style.display = 'flex';
        }
        function cerrarLegalModal() { document.getElementById('legalModal').style.display = 'none'; }

        function cambiarTabLegal(tab) {
            const tabTerminos = document.getElementById('tabLegalTerminos');
            const tabPrivacidad = document.getElementById('tabLegalPrivacidad');
            const contentTerminos = document.getElementById('legalContentTerminos');
            const contentPrivacidad = document.getElementById('legalContentPrivacidad');

            if (tab === 'terminos') {
                tabTerminos.classList.add('active');
                tabPrivacidad.classList.remove('active');
                contentTerminos.style.display = 'block';
                contentPrivacidad.style.display = 'none';
            } else {
                tabPrivacidad.classList.add('active');
                tabTerminos.classList.remove('active');
                contentPrivacidad.style.display = 'block';
                contentTerminos.style.display = 'none';
            }
        }

        window.addEventListener('click', (e) => {
            const legal = document.getElementById('legalModal');
            const auth = document.getElementById('authModal');
            const packs = document.getElementById('packsModal');
            const flyout = document.getElementById('supportFlyout');
            const fab = document.getElementById('supportFabBtn');
            const userDropdown = document.getElementById('userDropdownMenu');

            if (e.target === legal) cerrarLegalModal();
            if (e.target === auth) cerrarModal();
            if (e.target === packs) cerrarModalPacks();

            // Cerrar menú dropdown de usuario al hacer clic fuera
            if (userDropdown && userDropdown.style.display === 'block') {
                const userPill = document.querySelector('.user-pill');
                if (!userDropdown.contains(e.target) && (!userPill || !userPill.contains(e.target))) {
                    userDropdown.style.display = 'none';
                }
            }

            // Cerrar el flyout de tickets si se hace clic afuera de él y afuera del botón flotante
            if (flyout && flyout.style.display === 'flex') {
                if (!flyout.contains(e.target) && !fab.contains(e.target)) {
                    flyout.style.display = 'none';
                }
            }
        });

        // Iniciar verificación de sesión al cargar página
        checkSession();
    </script>
</body>
</html>