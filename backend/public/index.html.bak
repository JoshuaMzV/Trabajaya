                            <div class="member-initials">🤖</div>
                            <div class="member-info">
                                <div class="member-name">Walter</div>
                                <div class="member-role">Integración de IA</div>
                            </div>
                        </div>
                        <div class="team-member">
                            <div class="member-initials">🔍</div>
