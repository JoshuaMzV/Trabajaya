<%# Fila de competencia del asistente. Parámetros: c = { nombre, peso } · i (índice, o "__i__" en la plantilla) %>
<li class="comp-row" data-comp-row>
  <span class="comp-row__name" data-comp-name><%= c.nombre %></span>
  <input type="hidden" name="competencias" value="<%= c.nombre %>" data-comp-input>
  <label class="comp-row__weight">
    <span>Peso</span>
    <input type="range" name="pesos" min="1" max="5" step="1" value="<%= c.peso %>" aria-label="Peso de <%= c.nombre || 'la competencia' %>" data-comp-peso>
    <output class="comp-row__value" data-comp-peso-out><%= c.peso %></output>
  </label>
  <button type="button" class="btn-icon btn-icon--outline btn-icon--sm" data-comp-remove aria-label="Quitar <%= c.nombre || 'competencia' %>"><%- icon('x', { size: 16 }) %></button>
</li>
