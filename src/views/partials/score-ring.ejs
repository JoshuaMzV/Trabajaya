<%
  // Anillo de puntaje sobre fondo oscuro (landing, empresas, cómo funciona, dictamen).
  // Parámetros: valor (0–100) · tamano = sm (64px) | md (84px) | lg (96px) | xl (120px)
  // Opcionales: tema = 'light' (fondo claro) · label (para lectores de pantalla)
  const v = Math.max(0, Math.min(100, Number(valor) || 0));
  const t = locals.tamano || 'md';
  const tema = locals.tema === 'light' ? ' score-ring--light' : '';
%>
<span class="score-ring score-ring--<%= t %><%= tema %>" role="img" aria-label="<%= locals.label || `Puntaje ${v} de 100` %>">
  <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <circle class="score-ring__track" cx="50" cy="50" r="44" pathLength="100"></circle>
    <circle class="score-ring__value" cx="50" cy="50" r="44" pathLength="100" stroke-dasharray="<%= v %> 100" transform="rotate(-90 50 50)"></circle>
  </svg>
  <span class="score-ring__num" aria-hidden="true"><%= v %></span>
</span>
