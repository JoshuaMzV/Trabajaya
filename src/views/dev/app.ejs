<%
  const cfg = navApp[role];
  const item = cfg.items.find((i) => i.key === active) || cfg.items[0];
  const base = `/dev/componentes/app?role=${role}&active=${item.key}`;
%>
<div class="split">
  <div class="split__main page">
    <div class="page__header">
      <h1 class="title-app"><%= item.label %></h1>
      <div class="chip-group">
        <span class="badge badge--accent">Vista previa · layout app.ejs</span>
        <% if (role === 'cand') { %><span class="badge"><%= usuario.saldo %> monedas</span><% } %>
      </div>
    </div>

    <div class="card">
      <p class="card__text">Rol <strong><%= cfg.etiqueta %></strong> (<code>role=<%= role %></code>) con el ítem <strong><%= item.label %></strong> activo (<code>active=<%= item.key %></code>). Cambia de rol:</p>
      <div class="chip-group">
        <a class="chip"<% if (role === 'cand') { %> aria-current="page"<% } %> href="/dev/componentes/app?role=cand">Candidato</a>
        <a class="chip"<% if (role === 'rec') { %> aria-current="page"<% } %> href="/dev/componentes/app?role=rec">Empresa</a>
        <a class="chip"<% if (role === 'admin') { %> aria-current="page"<% } %> href="/dev/componentes/app?role=admin">Admin</a>
        <a class="chip" href="/dev/componentes">← Volver a componentes</a>
      </div>
    </div>

    <h2 class="display-3">Drawer desde la URL</h2>
    <p class="text-muted">Cada vacante es un enlace a <code>?vacante=:id</code>: el servidor abre el drawer (funciona sin JS). Al cerrarlo, <code>ui.js</code> lo oculta y limpia la URL.</p>
    <ul class="dev-list" role="list">
      <% vacantes.forEach((v) => { %>
        <li>
          <a class="dev-job" href="<%= base %>&amp;vacante=<%= v.id %>"<% if (vacanteSel && vacanteSel.id === v.id) { %> aria-current="true"<% } %>>
            <span class="avatar avatar--lg avatar--square" aria-hidden="true"><%= v.empresa.slice(0, 2).toUpperCase() %></span>
            <span class="dev-job__body">
              <span class="dev-job__title"><%= v.puesto %></span>
              <span class="dev-job__meta"><%= v.empresa %> · <%= v.ciudad %> · <%= v.modalidad %> · hace <%= v.dias %> días</span>
            </span>
            <span class="tag tag--match">Match <%= v.match %>%</span>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>

  <% if (vacanteSel) { %>
    <aside class="drawer" id="drawer-vacante" aria-labelledby="drawer-vacante-t" data-drawer-close-url="<%= base %>">
      <div class="drawer__header">
        <div class="dev-media">
          <span class="avatar avatar--lg avatar--square" aria-hidden="true"><%= vacanteSel.empresa.slice(0, 2).toUpperCase() %></span>
          <div class="dev-media__body">
            <h2 class="drawer__title" id="drawer-vacante-t"><%= vacanteSel.puesto %></h2>
            <span class="card__text"><%= vacanteSel.empresa %> · <%= vacanteSel.ciudad %></span>
          </div>
        </div>
        <a class="btn-icon" href="<%= base %>" data-drawer-close aria-label="Cerrar detalle"><%- icon('x', { size: 18 }) %></a>
      </div>
      <div class="chip-group"><span class="tag"><%= vacanteSel.modalidad %></span><span class="tag tag--match">Match <%= vacanteSel.match %>%</span></div>
      <a class="btn btn--accent btn--block" href="#">Postularme · inicia entrevista IA</a>
      <section class="drawer__section"><h3>Descripción</h3><p class="card__text">Contenido de la vacante <%= vacanteSel.id %> renderizado por el servidor.</p></section>
    </aside>
  <% } %>
</div>
